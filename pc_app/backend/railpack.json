{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "deploy": {
    "aptPackages": [
      "libxcb1",
      "libgl1",
      "libglib2.0-0",
      "libsm6",
      "libxext6",
      "libxrender1",
      "libgomp1"
    ],
    "startCommand": "python -m uvicorn app.main:app --host 0.0.0.0 --port $PORT"
  }
}
